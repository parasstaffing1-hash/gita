{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": true,
    // The renderer draws to a canvas and the encoder uses base64: both are
    // browser APIs, and this package is only ever used in a browser or in a
    // Node runtime that provides them.
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts"]
}
