# ---------------------------------------------------------------------------
# Bhagavad Gita platform — example environment.
# Copy to .env and fill in. NEVER commit real credentials.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
# Matches infrastructure/docker/docker-compose.yml defaults.
DATABASE_URL=postgresql+psycopg://gita:gita@localhost:5433/gita
# Sync URL used by Alembic (same DB, sync driver).
ALEMBIC_DATABASE_URL=postgresql+psycopg://gita:gita@localhost:5433/gita

# --- API -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:8081
# Secret used to sign session/access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
API_SECRET_KEY=change-me-in-production-please-generate-a-long-random-value
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=60
# Static bootstrap token for the admin panel / ingestion scripts.
ADMIN_API_TOKEN=dev-admin-token-change-me
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AI=10/minute

# --- Cloudflare R2 (audio, share assets, downloads) ------------------------
# TODO: required for real audio + share-card delivery. Obtain from Cloudflare.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gita-media
# Leave empty until a real CDN domain exists. A placeholder domain here
# looks configured and silently breaks every image the app serves.
R2_PUBLIC_BASE_URL=
R2_SIGNED_URL_TTL_SECONDS=3600

# Development-only fallback. While the R2 keys above are empty, the API serves
# the same object keys from this directory at LOCAL_MEDIA_BASE_URL, so the
# wallpaper picker and the quote maker have real files to load before any
# credentials exist. The mount is refused outright when ENVIRONMENT=production,
# where an unconfigured R2 is a deployment error rather than a convenience.
LOCAL_MEDIA_DIR=media
LOCAL_MEDIA_BASE_URL=http://localhost:8000/media

# --- AI provider (pluggable) ----------------------------------------------
# One of: anthropic | openai | gemini | openrouter | groq | ollama | echo
# "echo" is a deterministic offline provider used for local dev and tests.
AI_PROVIDER=echo
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=1200

# --- Embeddings ------------------------------------------------------------
# Local, open-source multilingual embeddings by default (no API key needed).
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384
# Set to 1 in CI/dev to use a deterministic hashing embedder (no model download).
EMBEDDING_USE_STUB=1

# --- Speech to text (pluggable, for mobile voice search) ------------------
STT_PROVIDER=none
STT_API_KEY=

# --- Monitoring & analytics -----------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# --- Web (Next.js public vars) --------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=

# --- Mobile (Expo public vars) --------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SENTRY_DSN=

# Identifies this deployment's own server-side renderer to the API, so a build
# or an ISR revalidation - which fetches every verse page from one address - is
# not rate limited as if it were abuse. Server-only: it must never carry the
# NEXT_PUBLIC_ prefix or it lands in the browser bundle. Leave empty to disable
# the exemption; an unset secret exempts nobody.
INTERNAL_API_TOKEN=
